{
  "app-id": "com.calvinhsia.sheetmusicviewer",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "SheetMusicViewer",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=home"
  ],
  "modules": [
    {
      "name": "sheetmusicviewer",
      "buildsystem": "simple",
      "build-commands": [
        "ls",
        "install -Dm755 SheetMusicViewer /app/bin/SheetMusicViewer",
        "install -Dm644 com.calvinhsia.sheetmusicviewer.desktop /app/share/applications/com.calvinhsia.sheetmusicviewer.desktop",
        "install -Dm644 music.ico /app/share/icons/hicolor/512x512/apps/com.calvinhsia.sheetmusicviewer.png",
        "cp -r Assets /app/bin/Assets"
      ],
      "sources": [
        {
          "type": "archive",
          "path": "/__w/SheetMusicViewer/SheetMusicViewer/artifacts/SheetMusicViewer-linux-x64/SheetMusicViewer-linux-x64.tar.gz",
          "strip-components": 0
        },
        {
          "type": "dir",
          "path": "flatpak"
        }
      ]
    }
  ]
}